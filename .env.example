# Core
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/simmi_masala?replicaSet=rs0
API_BASE_URL=http://localhost:4000
STOREFRONT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Auth (use a long random string in production)
SESSION_SECRET=dev-only-session-secret-change-me-32chars
COOKIE_SECURE=false

# Inventory
RESERVATION_TTL_MINUTES=15

# Super Admin seed (required for `pnpm seed:admin`)
SUPER_ADMIN_EMAIL=admin@simmimasala.local
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME=Super Admin

# Razorpay (leave empty until credentials are available — COD still works)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Storage: local | cloudinary
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / SMTP (optional — app remains usable without it)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Simmi Masala <noreply@simmimasala.local>

LOG_LEVEL=info

# Frontend (Vite) — never put secrets here
# apps/storefront/.env and apps/admin/.env:
# VITE_API_BASE_URL=http://localhost:4000/api/v1
# Admin path deploy only:
# VITE_BASE_PATH=/admin/
